---
import { App } from '../components/App';
import '../styles/app.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pattaya Stream</title>
    <!-- Google tag (gtag.js); is:inline keeps Astro from bundling it into a module,
         where gtag would stop being global. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YD0307VY2D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-YD0307VY2D');
    </script>
  </head>
  <body>
    <App client:only="react" />
  </body>
</html>
